# ============================================================
# TIMEFLOW — Environment Variables Reference
# Copy this file to .env and fill in your values.
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=8000
NODE_ENV=production          # development | production

# ── Database ────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=timeflow
DB_PASSWORD=your_db_password
DB_NAME=timesheet_db

# ── Authentication ──────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ── Wrike Integration ───────────────────────────────────────
WRIKE_API_KEY=your_wrike_api_key
WRIKE_API_BASE_URL=https://www.wrike.com/api/v4
WRIKE_FOLDER_ID=your_wrike_folder_id
WRIKE_WEBHOOK_SECRET=any_random_secret   # validates incoming webhook calls

# ── URLs ────────────────────────────────────────────────────
APP_URL=https://your-api-domain.com      # used in webhook registration URLs
FRONTEND_URL=https://your-app-domain.com # used for CORS allow-origin

# ── Payroll Defaults ────────────────────────────────────────
DEFAULT_HOURLY_RATE=500     # fallback hourly rate when not set on employee
CURRENCY=PHP                # default display currency (PHP | USD | BDT)

# ── Company Identity (shown in payslip PDFs) ────────────────
COMPANY_NAME=Your Company Name
COMPANY_ADDRESS=Full company address here
COMPANY_WEBSITE=yourcompany.com

# ── Payor Details (BIR bank file fields) ────────────────────
PAYOR_NAME=Your Company Legal Name
PAYOR_TIN=000-000-000-000
PAYOR_ADDRESS=Company address for BIR filings
PAYOR_ZIP_CODE=0000

# ── Bank Transfer File (Metrobank MBOS) ─────────────────────
# ISO 20022 EFT XLS — Domestic or Foreign Transfer (*.xls)
# Sender accounts by transfer currency — Metrobank requires the debited account's
# currency to match the transfer currency, and column D is per row, so one file
# may draw on several accounts. Format: CUR:account,CUR:account
BANK_SOURCE_ACCOUNTS=      # e.g. PHP:0011234567890,USD:0029876543210
BANK_SOURCE_ACCOUNT=       # single-account fallback for currencies not listed above
BANK_SENDER_CITY=          # sender town/city (required for Foreign Transfer)
BANK_SENDER_POSTAL_CODE=   # sender postal code (falls back to PAYOR_ZIP_CODE)
BANK_SENDER_COUNTRY=Philippines
BANK_CHARGE_TYPE=1         # who pays correspondent bank charges: 0=Beneficiary, 1=Our (sender), 2=Shared
BANK_PURPOSE_CODE=SALA     # ANNEX A purpose code used when an employee has none set
# Standard TAMA XLS — Transfer to Another Metrobank Account (*.xls)
# Needs no settings: the accepted layout is five columns (names, account, amount).

# ── Scheduling ──────────────────────────────────────────────
CRON_SCHEDULE=0 9 * * 1    # cron expression (default: Monday 9 AM)
TIMEZONE=Asia/Manila        # timezone for cron jobs
APPROVAL_REMINDER_DAYS=3   # days before sending approval reminders

# ── Redis Cache (optional) ──────────────────────────────────
# Leave blank / commented out to run without caching.
# REDIS_URL=redis://localhost:6379
